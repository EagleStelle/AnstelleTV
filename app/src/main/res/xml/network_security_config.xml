<?xml version="1.0" encoding="utf-8"?>
<!--
    Jellyfin servers, HDHomeRun tuners and M3U sources on a home LAN are usually plain HTTP
    on arbitrary IP addresses, so cleartext cannot be limited to a list of domains.
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
