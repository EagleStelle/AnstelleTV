<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing is backed up or transferred by the system. Jellyfin tokens are wrapped with a
    Keystore key that never leaves the device, and configuration moves between devices
    through the app's own export/import and LAN transfer instead.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
